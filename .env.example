# Copy to .env and fill in, then: docker compose up -d
# Daily report mail, sent when the Tamagotchi falls asleep for the night.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# defaults to SMTP_USER
MAIL_FROM=
MAIL_TO=
# 1 = one mail a day for all pets instead of one per pet; it goes out when the last pet
# has fallen asleep, at the latest at MAIL_DIGEST_AT
MAIL_DIGEST=
MAIL_DIGEST_AT=23:00

# The page for everyone (--public-port): the address it is reached at, for search engines
# and for the preview of a shared link. Without it there is no sitemap and no preview picture.
# PUBLIC_URL=https://tamagotchi.example.org
